# Copy this file to .env.local and fill in the values from your Supabase project.
# Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# ---- Bill scanner (optional) ----
# Reads a photographed shop bill and offers its line items.
# Google Cloud → APIs & Services → enable "Cloud Vision API", then create an
# API key under Credentials. The project needs a billing account attached even
# for the free 1,000 reads a month. Leave Application restrictions as "None"
# (the call comes from the server, not a browser) and restrict the key to the
# Cloud Vision API.
GOOGLE_VISION_API_KEY=

# Optional. Set both of these to read bills with Claude instead — slower and
# paid, but much better on handwriting.
#   SCAN_PROVIDER=claude
# If ANTHROPIC_API_KEY is set while SCAN_PROVIDER is google (the default),
# photos Google reads nothing from are retried on Claude automatically.
ANTHROPIC_API_KEY=
# SCAN_PROVIDER=google
# SCAN_MODEL=claude-opus-5
